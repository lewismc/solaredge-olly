# Non-secret defaults for /etc/solaredge/solaredge.env on the Pi.
# Copy to that path as root:root mode 0600. Do not commit a filled copy.
# Grafana passwords stay empty until the simulator scrape works.

# Simulator phase. At cutover, set this to the inverter address the operator supplies.
INVERTER_ADDRESS=127.0.0.1
INVERTER_PORT=502
NUMBER_METERS=0
INVERTER_CLIENT_ID=1
EXPORTER_INTERVAL=5
EXPORTER_ADDRESS=127.0.0.1
EXPORTER_PORT=2112
LOG_PATH=/var/log/solaredge/solaredge-exporter.log

SIM_LISTEN_ADDR=127.0.0.1

GEOLOCATE_LISTEN_ADDR=127.0.0.1
GEOLOCATE_PORT=9110
GEOLOCATE_CACHE=/var/lib/geolocate/location.json

# Leave SITE_LAT and SITE_LON empty to resolve the location from the public IP.
SITE_LAT=
SITE_LON=
PV_TILT=25
PV_AZIMUTH=0
PV_KWP=4.56
PV_PR=0.8
PV_AC_LIMIT_W=3800

GCLOUD_FM_COLLECTOR_ID=solaredge

# Placeholders. Alloy retries remote write until these are real.
GRAFANA_CLOUD_PROM_URL=https://prometheus-prod-XX-prod-REGION.grafana.net/api/prom/push
GRAFANA_CLOUD_PROM_USERNAME=
GRAFANA_CLOUD_PROM_PASSWORD=

GRAFANA_CLOUD_LOKI_URL=https://logs-prod-XX.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_USERNAME=
GRAFANA_CLOUD_LOKI_PASSWORD=

# Same token as GRAFANA_CLOUD_PROM_PASSWORD. Compose maps that name to this one.
GCLOUD_RW_API_KEY=

FLEET_MANAGEMENT_URL=https://fleet-management-REGION.grafana.net
FLEET_MANAGEMENT_USERNAME=
