#!/usr/bin/env python3
"""Start the private probe with the token from the Pi env file.

The token is passed to the agent in the environment. It is not printed.
"""
import os
import pwd

ENV_PATH = "/etc/solaredge/solaredge.env"
AGENT = "/opt/solaredge/bin/synthetic-monitoring-agent"

vals = {}
with open(ENV_PATH) as fh:
    for line in fh:
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        vals[key] = value

server = vals.get("SM_API_SERVER", "").strip()
token = vals.get("SM_AGENT_API_TOKEN", "").strip()
if not server or not token:
    raise SystemExit("SM_API_SERVER and SM_AGENT_API_TOKEN must be set")

os.environ["SM_AGENT_API_TOKEN"] = token
user = pwd.getpwnam("sm")
os.initgroups(user.pw_name, user.pw_gid)
os.setgid(user.pw_gid)
os.setuid(user.pw_uid)
os.execv(
    AGENT,
    [
        AGENT,
        f"--api-server-address={server}:443",
        "--k6-repository=/opt/solaredge/bin",
        "--k6-uri=/opt/solaredge/bin/k6",
        # 0.0.0.0/32 clears the agent's private-net denylist. The check
        # target resolves to 127.0.0.1 through /etc/hosts.
        "--blocked-nets=0.0.0.0/32",
    ],
)
