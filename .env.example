# Copy to .env and fill in the live inverter plus Grafana Cloud credentials.
# .env is gitignored.

# Comma-separated Modbus targets. A port after the host overrides INVERTER_PORT
# for that inverter: 192.0.2.10,192.0.2.10:1502
INVERTER_ADDRESS=192.0.2.10
INVERTER_PORT=502
NUMBER_METERS=0
INVERTER_CLIENT_ID=1
EXPORTER_INTERVAL=5

# Grafana Cloud Prometheus remote_write.
# URL looks like https://prometheus-prod-XX-prod-REGION.grafana.net/api/prom/push
# Username is the stack's Prometheus instance id.
# Password is an access-policy token with metrics:write.
GRAFANA_CLOUD_PROM_URL=https://prometheus-prod-XX-prod-REGION.grafana.net/api/prom/push
GRAFANA_CLOUD_PROM_USERNAME=
GRAFANA_CLOUD_PROM_PASSWORD=

# Grafana Cloud Loki push. This is not the Prometheus remote_write triple.
# URL looks like https://logs-prod-XX.grafana.net/loki/api/v1/push
# Username is the stack's Loki instance id.
# Password is an access-policy token with logs:write. It may be the same token
# as GRAFANA_CLOUD_PROM_PASSWORD when that policy includes both scopes.
GRAFANA_CLOUD_LOKI_URL=https://logs-prod-XX.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_USERNAME=
GRAFANA_CLOUD_LOKI_PASSWORD=

# Site location and expected yield (solaredge-geolocate). Optional.
# Leave SITE_LAT and SITE_LON empty to resolve the location from the public IP
# with an ipinfo.io lookup, at most once a day. The home's public IP is sent to
# ipinfo.io for that lookup. Set both to use a fixed location and make no IP lookup.
# Coordinates keep 4 decimal places, about 11 m. ipinfo returns this precision;
# rounding coarser than that moves the map marker by hundreds of metres.
SITE_LAT=
SITE_LON=
# PV array assumptions for expected AC power:
#   expected W = min(GTI W/m2 * PV_KWP * PV_PR, PV_AC_LIMIT_W)
# PV_TILT is degrees from horizontal. PV_AZIMUTH is 0 for south, -90 east, 90 west.
PV_TILT=25
PV_AZIMUTH=0
PV_KWP=4.56
PV_PR=0.8
PV_AC_LIMIT_W=3800

# Fleet Management bootstrap for alloy/config.alloy. The URL is the Base URL from
# Connections > Fleet Management > API. The username is the numeric instance id on
# that tab. The collector password is GRAFANA_CLOUD_PROM_PASSWORD, which must
# include the set:alloy-data-write scope. Compose passes it as GCLOUD_RW_API_KEY.
FLEET_MANAGEMENT_URL=https://fleet-management-REGION.grafana.net
FLEET_MANAGEMENT_USERNAME=

# Synthetic Monitoring private probe. Host only: no scheme and no port.
# Compose appends :443. This is the gRPC host the agent dials, not the HTTP API host.
# SM_API_TOKEN is the one-time probe token. It is not a Grafana access-policy token.
# Both variables are required. docker compose fails until they are set.
SM_API_SERVER=synthetic-monitoring-grpc-REGION.grafana.net
SM_API_TOKEN=
