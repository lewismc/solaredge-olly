// SolarEdge collector.
//
// Loads the module shipped in this repository. Grafana Cloud credentials come from
// the process environment and are never written into this file.

import.file "solaredge_module" {
	filename = "/etc/alloy/module/metrics.alloy"
}

// Every metric this pipeline ships carries the same namespace and environment.
// The Knowledge Graph maps deployment_environment to its env scope. The series
// from the generated self_monitoring_metrics pipeline do not pass through here.
prometheus.relabel "common" {
	forward_to = [prometheus.remote_write.cloud.receiver]

	rule {
		target_label = "service_namespace"
		replacement  = "solaredge"
	}

	rule {
		target_label = "deployment_environment"
		replacement  = "home"
	}
}

prometheus.remote_write "cloud" {
	endpoint {
		url = sys.env("GRAFANA_CLOUD_PROM_URL")

		basic_auth {
			username = sys.env("GRAFANA_CLOUD_PROM_USERNAME")
			password = sys.env("GRAFANA_CLOUD_PROM_PASSWORD")
		}
	}
}

solaredge_module.local "exporter" {
	exporter_address = "solaredge-exporter:2112"
}

solaredge_module.scrape "inverter" {
	targets    = solaredge_module.local.exporter.output
	forward_to = [prometheus.relabel.common.receiver]
}

// Site location and expected yield from solaredge-geolocate. A separate job, so
// the inverter alerts and SLOs on integrations/solaredge do not change.
solaredge_module.local "geolocate" {
	exporter_address = "solaredge-geolocate:9110"
}

solaredge_module.scrape "geolocate" {
	targets      = solaredge_module.local.geolocate.output
	job_label    = "integrations/solaredge-geolocate"
	keep_metrics = "(up|Site_.+)"
	forward_to   = [prometheus.relabel.common.receiver]
}

// Alloy's own metrics, every family /metrics exposes. The generated
// self_monitoring_metrics pipeline in Fleet Management already ships a keep-list
// of them to the same Prometheus instance with the same job, instance, and
// collector_id labels. Those names are dropped here so the two pipelines never
// write the same series. The regex is a copy of that pipeline's keep rule;
// update it when the generated pipelines are recreated.
prometheus.exporter.self "alloy" { }

discovery.relabel "alloy" {
	targets = prometheus.exporter.self.alloy.targets

	rule {
		target_label = "collector_id"
		replacement  = sys.env("GCLOUD_FM_COLLECTOR_ID")
	}

	rule {
		target_label = "instance"
		replacement  = constants.hostname
	}

	rule {
		target_label = "job"
		replacement  = "integrations/alloy"
	}
}

prometheus.scrape "alloy" {
	targets         = discovery.relabel.alloy.output
	forward_to      = [prometheus.relabel.alloy.receiver]
	job_name        = "integrations/alloy"
	scrape_interval = "60s"
}

prometheus.relabel "alloy" {
	forward_to = [prometheus.relabel.common.receiver]

	rule {
		source_labels = ["__name__"]
		regex         = "alloy_build_info|alloy_component_controller_running_components|alloy_component_dependencies_wait_seconds|alloy_component_dependencies_wait_seconds_bucket|alloy_component_evaluation_seconds|alloy_component_evaluation_seconds_bucket|alloy_component_evaluation_seconds_count|alloy_component_evaluation_seconds_sum|alloy_component_evaluation_slow_seconds|alloy_config_hash|alloy_resources_machine_rx_bytes_total|alloy_resources_machine_tx_bytes_total|alloy_resources_process_cpu_seconds_total|alloy_resources_process_resident_memory_bytes|cluster_node_gossip_health_score|cluster_node_gossip_proto_version|cluster_node_gossip_received_events_total|cluster_node_info|cluster_node_lamport_time|cluster_node_peers|cluster_node_update_observers|cluster_transport_rx_bytes_total|cluster_transport_rx_packet_queue_length|cluster_transport_rx_packets_failed_total|cluster_transport_rx_packets_total|cluster_transport_stream_rx_bytes_total|cluster_transport_stream_rx_packets_failed_total|cluster_transport_stream_rx_packets_total|cluster_transport_stream_tx_bytes_total|cluster_transport_stream_tx_packets_failed_total|cluster_transport_stream_tx_packets_total|cluster_transport_streams|cluster_transport_tx_bytes_total|cluster_transport_tx_packet_queue_length|cluster_transport_tx_packets_failed_total|cluster_transport_tx_packets_total|go_gc_duration_seconds_count|go_goroutines|go_memstats_heap_inuse_bytes|otelcol_exporter_send_failed_spans_total|otelcol_exporter_sent_spans_total|otelcol_processor_batch_batch_send_size_bucket|otelcol_processor_batch_metadata_cardinality|otelcol_processor_batch_timeout_trigger_send_total|otelcol_receiver_accepted_spans_total|otelcol_receiver_refused_spans_total|prometheus_remote_storage_bytes_total|prometheus_remote_storage_highest_timestamp_in_seconds|prometheus_remote_storage_metadata_bytes_total|prometheus_remote_storage_queue_highest_sent_timestamp_seconds|prometheus_remote_storage_samples_failed_total|prometheus_remote_storage_samples_retried_total|prometheus_remote_storage_samples_total|prometheus_remote_storage_sent_batch_duration_seconds_bucket|prometheus_remote_storage_sent_batch_duration_seconds_count|prometheus_remote_storage_sent_batch_duration_seconds_sum|prometheus_remote_storage_shards|prometheus_remote_storage_shards_max|prometheus_remote_storage_shards_min|prometheus_remote_write_wal_samples_appended_total|prometheus_remote_write_wal_storage_active_series|rpc_server_duration_milliseconds_bucket|scrape_duration_seconds|up"
		action        = "drop"
	}
}

// Host metrics from node-exporter.service, a separate binary with its own
// MemoryMax, so Alloy does not load prometheus.exporter.unix. job and instance
// match the Raspberry Pi integration, so its dashboards and alerts select this
// host. solaredge_unit_* comes from the textfile collector (cgroup memory per
// unit). Collector timings are dropped.
prometheus.scrape "node" {
	targets = [{
		__address__ = "127.0.0.1:9100",
		instance    = constants.hostname,
	}]
	forward_to      = [prometheus.relabel.node.receiver]
	job_name        = "integrations/raspberrypi-node"
	scrape_interval = "60s"
	scrape_timeout  = "10s"
}

prometheus.relabel "node" {
	forward_to = [prometheus.relabel.common.receiver]

	rule {
		source_labels = ["__name__"]
		regex         = "up|node_.+|solaredge_unit_.+"
		action        = "keep"
	}

	rule {
		source_labels = ["__name__"]
		regex         = "node_scrape_collector_duration_seconds|node_filesystem_(purgeable_bytes|mount_info|device_error)"
		action        = "drop"
	}
}

// The exporter appends JSON lines to a shared volume. loki.source.file records
// a byte offset, so a restart continues after the last byte. The Docker log
// API cursor is only a unix second and is keyed by the label set, so a restart
// or a label change ships lines that were already sent.
// Stream labels are service_name and job, plus the static service_namespace and
// deployment_environment every metric carries. job matches the scrape job, so a
// metric and its logs share a selector. The inverter address stays in the
// line body; it moves with the DHCP lease.

local.file_match "exporter" {
	path_targets = [{
		__path__     = "/var/log/solaredge/solaredge-exporter.log",
		job          = "integrations/solaredge",
		service_name = "solaredge-exporter",
	}]
}

loki.source.file "exporter" {
	targets    = local.file_match.exporter.targets
	forward_to = [loki.process.exporter.receiver]
}

loki.process "exporter" {
	stage.label_keep {
		values = ["service_name", "job"]
	}

	stage.static_labels {
		values = {
			service_namespace      = "solaredge",
			deployment_environment = "home",
		}
	}

	forward_to = [loki.write.cloud.receiver]
}

loki.write "cloud" {
	endpoint {
		url = sys.env("GRAFANA_CLOUD_LOKI_URL")

		basic_auth {
			username = sys.env("GRAFANA_CLOUD_LOKI_USERNAME")
			password = sys.env("GRAFANA_CLOUD_LOKI_PASSWORD")
		}
	}
}
