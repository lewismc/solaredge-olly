// SolarEdge collector bootstrap.
//
// This file registers the collector with Fleet Management and ships the
// collector's own logs. The pipeline is fleet/solaredge.alloy, published by
// .github/workflows/fleet-management-sync.yml and applied remotely. Credentials
// come from the process environment.

// Alloy's own logs go to stderr (docker logs) and to Loki. The autogenerated
// self_monitoring_logs_linux pipeline reads the systemd journal, which this
// container does not have, so the tee lives here. Fleet Management's Logs tab
// finds these lines by job and collector_id. The four resource labels match
// the metrics pipeline: service_name, service_namespace,
// deployment_environment, and service_instance_id.
logging {
	level    = "info"
	format   = "logfmt"
	write_to = [loki.process.self.receiver]
}

loki.process "self" {
	stage.static_labels {
		values = {
			job                    = "integrations/alloy",
			collector_id           = "solaredge",
			service_name           = "alloy",
			service_namespace      = "solaredge",
			deployment_environment = "home",
			service_instance_id    = constants.hostname,
		}
	}

	forward_to = [loki.write.self.receiver]
}

loki.write "self" {
	endpoint {
		url = sys.env("GRAFANA_CLOUD_LOKI_URL")

		basic_auth {
			username = sys.env("GRAFANA_CLOUD_LOKI_USERNAME")
			password = sys.env("GRAFANA_CLOUD_LOKI_PASSWORD")
		}
	}
}

remotecfg {
	url = sys.env("FLEET_MANAGEMENT_URL")

	basic_auth {
		username = sys.env("FLEET_MANAGEMENT_USERNAME")
		password = sys.env("GCLOUD_RW_API_KEY")
	}

	id             = "solaredge"
	poll_frequency = "1m"

	attributes = {
		integration = "solaredge",
	}
}
