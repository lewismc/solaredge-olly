// SolarEdge collector bootstrap.
//
// This file only registers the collector with Fleet Management. The pipeline is
// fleet/solaredge.alloy, published by .github/workflows/fleet-management-sync.yml
// and applied remotely. Credentials come from the process environment.

remotecfg {
	url = sys.env("FLEET_MANAGEMENT_URL")

	basic_auth {
		username = sys.env("FLEET_MANAGEMENT_USERNAME")
		password = sys.env("GCLOUD_RW_API_KEY")
	}

	id             = "solaredge"
	poll_frequency = "1m"

	attributes = {
		integration = "solaredge",
	}
}
